{
  "name": "pizzapdv",
  "private": true,
  "version": "0.1.0",
  "description": "PizzaPDV - Sistema de caixa e atendimento para pizzaria (Site + Central)",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:site": "pnpm --filter @pizzapdv/site dev",
    "dev:central": "pnpm --filter @pizzapdv/central dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:push": "pnpm --filter @pizzapdv/api db:push",
    "db:seed": "pnpm --filter @pizzapdv/api db:seed"
  },
  "engines": {
    "node": ">=20"
  }
}
